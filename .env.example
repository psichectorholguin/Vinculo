# Supabase te da DOS direcciones de conexión (botón "Connect" en tu proyecto). Copia ambas:
# DATABASE_URL = la que dice "Transaction pooler" (termina en puerto 6543) — la usa tu app.
# DIRECT_URL   = la que dice "Direct connection" (termina en puerto 5432) — solo para crear tablas.
# En las dos, reemplaza [YOUR-PASSWORD] por la contraseña que creaste al hacer el proyecto.
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.gciemwdjhfekafgvrqcj:ProyectoVinculoPs1c@01.-%@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.gciemwdjhfekafgvrqcj:ProyectoVinculoPs1c@01.-%@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
JWT_SECRET="cambia-esto-por-un-secreto-largo"
APP_BASE_URL="https://app.tudominio.com"
PORT=3000

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v20.0"

# Email (Resend; puedes cambiar el proveedor en email.service.js)
RESEND_API_KEY=""
EMAIL_FROM="PsicoHoy <no-reply@tudominio.com>"

# Poner en "false" en las instancias que NO deben correr el scheduler
RUN_SCHEDULER="true"

# Secreto compartido con el cron externo que llama /internal/cron/run-reminders
CRON_SECRET="genera-un-valor-largo-y-aleatorio"
RUN_SCHEDULER_INPROCESS="false"

# Historia clínica — cifrado de campo
# Generar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLINICAL_ENCRYPTION_KEY=""

# Almacenamiento privado de documentos (S3-compatible: Supabase Storage, R2, AWS S3)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="clinical-documents"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
